# Copy to .env.local and fill in. NEVER commit .env.local.

# ─── DATABASE (PostgreSQL) ────────────────────────────────
# Easiest: a free Neon or Supabase project. Paste its connection string here.
DATABASE_URL="postgresql://user:password@localhost:5432/comrade_market"

# ─── AUTH ─────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32   (also used to hash OTP codes)
NEXTAUTH_SECRET=""

# ─── APP ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL=""

# ─── ADMIN (used by `npm run db:seed`) ────────────────────
ADMIN_EMAIL=""
ADMIN_PHONE="254712345678"
ADMIN_PASSWORD=""          # 12+ characters

# ─── PAYMENTS ─────────────────────────────────────────────
# "mock" = nothing real happens; a DEV button on the order page fakes the M-Pesa PIN. Never allowed in production.
# "intasend" = real M-Pesa. Test in the IntaSend SANDBOX first (INTASEND_TEST_MODE=true).
PAYMENT_PROVIDER="mock"
INTASEND_PUBLISHABLE_KEY=""
INTASEND_SECRET_KEY=""
INTASEND_TEST_MODE="true"
# Set the same value as the "challenge" when you create the webhook in the IntaSend dashboard.
# Webhook URL: https://<your-domain>/api/webhooks/payments
INTASEND_WEBHOOK_CHALLENGE=""

# ─── SCHEDULED JOB ────────────────────────────────────────
# Call GET /api/cron/maintenance every ~5 min with header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# ─── SMS (Africa's Talking). Leave blank in dev: codes print to the terminal. ──
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""

# ─── IMAGE STORAGE. Leave blank in dev: files go to .private-uploads/ and public/uploads/. ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
