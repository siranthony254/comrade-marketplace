// ─────────────────────────────────────────────────────────────
// COMRADE MARKET — PHASE 1 SCHEMA (students only, one campus first)
//
// Money: ALWAYS whole Kenyan shillings stored as Int. Never Float.
//        (M-Pesa moves whole shillings; floats cause rounding bugs.)
//
// Phase 2/3 models (suppliers, chama, savings, briefs, education...) live in
// docs/schema.full-vision.prisma and are added back when their phase starts.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  ADMIN
}

/// PENDING_REVIEW: can log in, cannot sell or buy until an admin approves the ID.
enum AccountStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
}

enum SchoolType {
  UNIVERSITY
  COLLEGE
  KMTC
  TVET
}

enum ProductType {
  PHYSICAL
  SERVICE
  DIGITAL
}

/// ESCROW: buyer pays the platform's payment provider up front, released on receipt.
/// ON_DELIVERY: buyer pays the seller cash, in person. No fee, no protection.
/// DIRECT_TRANSFER: buyer sends M-Pesa straight to the seller's own till/paybill/phone,
///   outside the platform entirely. No fee (the platform never touches the money), and
///   — unlike ESCROW — the platform has NO way to force a refund if something goes wrong.
///   This exists as a stand-in for ESCROW until a payment provider is integrated: it's the
///   only way to offer SOME accountability (a traceable M-Pesa transaction, a confirmation
///   handshake, dispute mediation) for services/bigger orders in the meantime.
enum PaymentMode {
  ESCROW
  ON_DELIVERY
  DIRECT_TRANSFER
}

enum MpesaMethod {
  TILL
  PAYBILL
  PHONE
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  READY
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum EscrowStatus {
  NONE
  AWAITING_PAYMENT
  HELD
  RELEASED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PayoutKind {
  SELLER_PAYOUT
  BUYER_REFUND
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum DisputeStatus {
  OPEN
  RESOLVED_BUYER
  RESOLVED_SELLER
}

enum PostType {
  STOCK_UPDATE    // Seller announcing stock changes
  NEED_ITEM       // Buyer looking for something
  GENERAL         // General post
  PROMO           // Promotional post
}

// ─── USERS ────────────────────────────────────────────────────

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  phone            String        @unique // normalised 2547XXXXXXXX
  passwordHash     String
  role             UserRole      @default(STUDENT)
  status           AccountStatus @default(PENDING_REVIEW)
  phoneVerifiedAt  DateTime? // set via self-service OTP, any time after signup — never required to register
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  studentProfile StudentProfile?
  notifications  Notification[]

  @@index([role, status])
}

model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model School {
  id        String     @id @default(cuid())
  name      String     @unique
  shortName String
  type      SchoolType
  county    String
  town      String
  isActive  Boolean    @default(true)

  students   StudentProfile[]
  businesses Business[]
}

model StudentProfile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String

  schoolId      String
  school        School  @relation(fields: [schoolId], references: [id])
  idNumber      String
  courseOfStudy String?
  yearOfStudy   Int?

  // Verification. Files are PRIVATE storage keys, never public URLs.
  idPhotoKey            String?
  selfieKey             String?
  verifiedAt            DateTime?
  verificationExpiresAt DateTime? // students graduate: re-verify after this
  reviewedById          String?
  reviewNote            String?

  business     Business?
  buyerOrders  Order[]   @relation("BuyerOrders")
  reviewsGiven Review[]
  disputes     Dispute[]

  posts       Post[]
  likes       Like[]
  comments    Comment[]
  shares      Share[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Student numbers are only unique within one institution.
  @@unique([schoolId, idNumber])
}

// ─── STOREFRONT ───────────────────────────────────────────────

model Business {
  id      String         @id @default(cuid())
  ownerId String         @unique // one business per student in Phase 1
  owner   StudentProfile @relation(fields: [ownerId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name        String
  slug        String  @unique
  tagline     String?
  description String?
  category    String
  logoUrl     String?
  bannerUrl   String?

  whatsappNumber  String? // normalised 2547XXXXXXXX
  acceptsDelivery Boolean  @default(false)
  deliveryAreas   String[]

  // Where buyers send money directly (DIRECT_TRANSFER orders). Null until the seller sets
  // it up — until then their storefront can only offer ON_DELIVERY (and ESCROW, once live).
  mpesaMethod  MpesaMethod?
  mpesaNumber  String? // the till number, paybill number, or phone — whichever mpesaMethod says
  mpesaAccount String? // paybill account/reference, only used when mpesaMethod = PAYBILL

  isOpen   Boolean @default(true) // seller toggles: "I'm taking orders"
  isActive Boolean @default(true) // admin toggles: visible on the platform

  products Product[]
  orders   Order[]
  reviews  Review[]
  posts    Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, isActive])
  @@index([category])
}

model Product {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name          String
  description   String
  type          ProductType @default(PHYSICAL)
  images        String[]
  price         Int // KES
  costPrice     Int? // KES, private
  stock         Int? // null = unlimited (services)
  lowStockAlert Int?
  category      String?
  isActive      Boolean     @default(true)

  turnaroundDays Int? // services

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, isActive])
}

// ─── ORDERS, PAYMENTS, ESCROW ─────────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // human readable, e.g. CM-7K3P9Q

  buyerId    String
  buyer      StudentProfile @relation("BuyerOrders", fields: [buyerId], references: [id])
  businessId String
  business   Business       @relation(fields: [businessId], references: [id])

  paymentMode  PaymentMode
  status       OrderStatus  @default(PENDING_PAYMENT)
  escrowStatus EscrowStatus @default(NONE)

  subtotal     Int // KES sum of items
  total        Int // KES buyer pays (== subtotal in Phase 1; fee comes out of seller side)
  platformFee  Int // KES kept by platform (0 for ON_DELIVERY)
  sellerPayout Int // KES total - platformFee

  deliveryMethod  DeliveryMethod
  deliveryAddress String?
  buyerNote       String?
  buyerPhone      String // M-Pesa number for the STK push (ESCROW) or just a contact number otherwise

  // DIRECT_TRANSFER payment handshake — a confirmation trail, not a money-safety guarantee.
  // The seller must set sellerConfirmedPaidAt before CONFIRM is allowed (see applyOrderAction).
  buyerMarkedPaidAt     DateTime?
  buyerPaymentRef       String? // buyer-typed M-Pesa confirmation code, e.g. "QFT5X7YABC" — not verified against Safaricom
  buyerPaymentProofKey  String? // optional screenshot of the M-Pesa SMS, PRIVATE storage key
  sellerConfirmedPaidAt DateTime?

  placedAt      DateTime?
  confirmedAt   DateTime?
  readyAt       DateTime?
  deliveredAt   DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  autoReleaseAt DateTime? // set on DELIVERED; cron completes the order after this
  expiresAt     DateTime? // PENDING_PAYMENT orders die here and free their stock

  items    OrderItem[]
  payments Payment[]
  payouts  Payout[]
  review   Review?
  dispute  Dispute?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId, createdAt])
  @@index([businessId, status])
  @@index([status, autoReleaseAt])
  @@index([status, expiresAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Snapshots: editing/deleting a product must never rewrite order history.
  nameSnapshot String
  unitPrice    Int
  quantity     Int
  lineTotal    Int
}

/// Money IN (buyer -> payment provider).
model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  provider    String // "mock" | "intasend"
  apiRef      String        @unique // our reference, sent to the provider
  providerRef String?       @unique // provider's invoice id
  amount      Int
  phone       String
  status      PaymentStatus @default(PENDING)
  failReason  String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([orderId])
}

/// Money OUT (platform -> seller, or platform -> buyer on refund).
model Payout {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])
  kind        PayoutKind
  phone       String // frozen at creation time
  recipient   String // display name for the provider narrative
  amount      Int
  status      PayoutStatus @default(PENDING)
  providerRef String?
  attempts    Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  // One seller payout and at most one refund per order. This is the
  // database-level guarantee against paying an order out twice.
  @@unique([orderId, kind])
  @@index([status])
}

/// Every webhook we receive, keyed for idempotency (providers retry).
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventKey    String    @unique
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

// ─── TRUST ────────────────────────────────────────────────────

model Review {
  id         String         @id @default(cuid())
  orderId    String         @unique
  order      Order          @relation(fields: [orderId], references: [id])
  businessId String
  business   Business       @relation(fields: [businessId], references: [id])
  reviewerId String
  reviewer   StudentProfile @relation(fields: [reviewerId], references: [id])
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime       @default(now())

  @@index([businessId, createdAt])
}

model Dispute {
  id           String         @id @default(cuid())
  orderId      String         @unique
  order        Order          @relation(fields: [orderId], references: [id])
  raisedById   String
  raisedBy     StudentProfile @relation(fields: [raisedById], references: [id])
  reason       String
  description  String
  status       DisputeStatus  @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([status, createdAt])
}

// ─── PLATFORM ─────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// ─── SOCIAL FEED ───────────────────────────────────────────────

model Post {
  id          String         @id @default(cuid())
  authorId    String
  author      StudentProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  businessId  String?        // Optional: link to seller's business
  business    Business?      @relation(fields: [businessId], references: [id])

  type        PostType       @default(GENERAL)
  content     String         @db.Text
  images      String[]       // Cloudinary URLs
  linkUrl     String?        // Optional link to product page or external
  linkTitle   String?        // Optional link preview title
  linkDescription String?    // Optional link preview description
  linkImage   String?        // Optional link preview image

  likes       Like[]
  comments    Comment[]
  shares      Share[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([type])
}

model Like {
  id        String         @id @default(cuid())
  postId    String
  post      Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      StudentProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime       @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String         @id @default(cuid())
  postId    String
  post      Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    StudentProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String         @db.Text
  parentId  String?        // For nested replies
  parent    Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]      @relation("CommentReplies")

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([postId, createdAt])
  @@index([authorId])
}

model Share {
  id          String         @id @default(cuid())
  postId      String
  post        Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  sharedById  String
  sharedBy    StudentProfile @relation(fields: [sharedById], references: [id], onDelete: Cascade)
  shareUrl    String         // The unique shareable URL for this share

  createdAt   DateTime       @default(now())

  @@unique([shareUrl])
  @@index([postId])
  @@index([sharedById])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
